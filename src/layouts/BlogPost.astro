---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="zh-TW">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={480} src={heroImage} alt={title} />
					</div>
				)}
				<div class="prose">
					<header class="post-header">
						<div class="meta">
							<span class="date"><FormattedDate date={pubDate} /></span>
							{updatedDate && (
								<span class="updated">· 更新於 <FormattedDate date={updatedDate} /></span>
							)}
						</div>
						<h1>{title}</h1>
						<p class="description">{description}</p>
						{tags && tags.length > 0 && (
							<div class="tags">
								{tags.map(tag => <span class="tag">#{tag}</span>)}
							</div>
						)}
						<hr />
					</header>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
		padding: 0;
	}
	.hero-image {
		width: 100%;
		max-height: 460px;
		overflow: hidden;
	}
	.hero-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 0;
		display: block;
	}
	.prose {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: auto;
		padding: 2.5em 1em 4em;
	}
	.post-header {
		margin-bottom: 2em;
	}
	.meta {
		font-size: 0.85em;
		color: #666;
		margin-bottom: 0.8em;
	}
	.updated { color: #555; }
	.post-header h1 {
		font-size: 2.2em;
		line-height: 1.25;
		margin: 0 0 0.5em;
		color: #F5F0E8;
	}
	.description {
		font-size: 1.05em;
		color: #a09880;
		margin: 0 0 1em;
		line-height: 1.7;
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-bottom: 1.2em;
	}
	.tag {
		font-size: 0.78em;
		background: rgba(192,57,43,0.2);
		color: #E67E22;
		padding: 0.2em 0.6em;
		border-radius: 999px;
		border: 1px solid rgba(192,57,43,0.3);
	}
	hr {
		border: none;
		border-top: 1px solid #333;
		margin: 1.5em 0 2em;
	}

	@media (max-width: 720px) {
		.post-header h1 { font-size: 1.6em; }
		.hero-image { max-height: 240px; }
	}
</style>
