---
const today = new Date();
---

<footer>
	<div class="footer-inner">
		<p class="brand">🍜 台北拉麵地圖</p>
		<p class="copy">&copy; {today.getFullYear()} 台北拉麵地圖．用心整理每一碗好麵</p>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid #333;
		padding: 2.5em 1em;
		background: #111;
		text-align: center;
	}
	.footer-inner {
		max-width: 860px;
		margin: auto;
	}
	.brand {
		font-size: 1.1em;
		font-weight: 700;
		color: #E67E22;
		margin: 0 0 0.4em;
	}
	.copy {
		font-size: 0.85em;
		color: #666;
		margin: 0;
	}
</style>
