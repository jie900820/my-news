---
import { SITE_TITLE } from '../consts.js';
import HeaderLink from './HeaderLink.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header>
	<nav>
		<a class="site-title" href={`${base}/`}>
			<span class="bowl">🍜</span>
			{SITE_TITLE}
		</a>
		<div class="nav-links">
			<HeaderLink href={`${base}/`}>首頁</HeaderLink>
			<HeaderLink href={`${base}/blog`}>所有文章</HeaderLink>
			<HeaderLink href={`${base}/about`}>關於</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: rgba(20, 20, 20, 0.92);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid #333;
		padding: 0 1.5em;
	}
	nav {
		max-width: 860px;
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 60px;
	}
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.4em;
		font-size: 1.1em;
		font-weight: 700;
		color: #F5F0E8;
		text-decoration: none;
		letter-spacing: 0.02em;
	}
	.site-title:hover { color: #E67E22; }
	.bowl {
		font-size: 1.3em;
		line-height: 1;
	}
	.nav-links {
		display: flex;
		gap: 0.2em;
	}
	@media (max-width: 480px) {
		.site-title span.bowl { display: none; }
		nav { height: 52px; }
	}
</style>
