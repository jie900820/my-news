---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts.js';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="zh-TW">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.intro {
				margin-bottom: 2.5rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			.post-list {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
				list-style: none;
				margin: 0;
				padding: 0;
			}
			.post-list li a {
				display: flex;
				gap: 1.2rem;
				text-decoration: none;
				color: inherit;
				align-items: flex-start;
				padding: 1rem;
				border-radius: 8px;
				transition: background 0.2s;
			}
			.post-list li a:hover {
				background: rgb(var(--gray-light));
			}
			.post-list img {
				width: 120px;
				height: 80px;
				object-fit: cover;
				border-radius: 6px;
				flex-shrink: 0;
			}
			.post-info h2 {
				font-size: 1.1rem;
				margin: 0 0 0.3rem;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			.post-info .desc {
				font-size: 0.9rem;
				color: rgb(var(--gray));
				margin: 0 0 0.3rem;
			}
			.post-info .date {
				font-size: 0.8rem;
				color: rgb(var(--gray));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.4rem;
			}
			.tag {
				font-size: 0.75rem;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
			}
			@media (max-width: 720px) {
				.post-list li a {
					flex-direction: column;
				}
				.post-list img {
					width: 100%;
					height: 160px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="intro">
				<h1>🍜 台北拉麵地圖</h1>
				<p>比較各個拉麵，供你挑選。</p>
				<p>整理台北不同風格的拉麵店，包含湯頭特色、麵體口感、排隊狀況與個人心得。</p>
				<p>不論你喜歡濃厚豚骨、清爽雞白湯、魚介系還是限定口味，都能快速找到適合你的拉麵。</p>
			</div>

			<h2>最新文章</h2>
			<ul class="post-list">
				{posts.map((post) => (
					<li>
						<a href={`${base}/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image width={120} height={80} src={post.data.heroImage} alt={post.data.title} />
							)}
							<div class="post-info">
								<h2>{post.data.title}</h2>
								<p class="desc">{post.data.description}</p>
								<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								{post.data.tags && (
									<div class="tags">
										{post.data.tags.map((tag) => (
											<span class="tag">#{tag}</span>
										))}
									</div>
								)}
							</div>
						</a>
					</li>
				))}
			</ul>
		</main>
		<Footer />
	</body>
</html>
